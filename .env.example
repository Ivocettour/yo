# ---------------------------------------------------------------------------
# Variables de entorno — copiá este archivo a .env (o .env.local) y completá.
# NUNCA subas .env con valores reales al repositorio.
# ---------------------------------------------------------------------------

# Conexión a PostgreSQL usada por la app en runtime.
# - Local: `npm run db:dev` levanta Prisma Postgres local e imprime esta URL.
# - Vercel + Neon: usar la URL "pooled" (con -pooler en el host).
# - Vercel + Prisma Postgres / Supabase: la URL de conexión directa TCP.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# (Opcional) Conexión directa sin pooler, usada SOLO para migraciones.
# En Neon es la URL sin "-pooler". Si no se define, se usa DATABASE_URL.
# DIRECT_URL="postgres://user:pass@host/db?sslmode=require"

# Secreto para firmar cookies de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Permitir registro de nuevos usuarios desde /register.
# Si no está en "true", solo se puede crear el PRIMER usuario (cuando la base está vacía)
# o usar `npm run user:create`.
ALLOW_REGISTRATION="false"

# Zona horaria por defecto para nuevos usuarios (para calcular "hoy", "esta semana", etc.)
DEFAULT_TIMEZONE="America/Argentina/Buenos_Aires"

# (Opcional) Usuario demo creado por `npm run db:seed` (solo para datos de prueba).
# SEED_EMAIL="demo@gastos.local"
# SEED_PASSWORD="demo1234"
